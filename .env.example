# El gateway enruta por prefijo de servicio, asi que la URL base es solo el host y
# cada ruta de endpoint carga su propio prefijo. Eso deja una sola base para todos
# los contextos: invoicing e invoicing/profile entraran igual, con su prefijo.
VITE_PLATFORM_API_URL="http://localhost:8080"
VITE_SIGN_UP_ENDPOINT_PATH="/iam/api/v1/authentication/sign-up"
VITE_SIGN_IN_ENDPOINT_PATH="/iam/api/v1/authentication/sign-in"
VITE_FORGOT_PASSWORD_ENDPOINT_PATH="/iam/api/v1/authentication/forgot-password"
VITE_RESET_PASSWORD_ENDPOINT_PATH="/iam/api/v1/authentication/reset-password"
VITE_USERS_ENDPOINT_PATH="/iam/api/v1/users"

# El API Gateway (vankoo-api-gateway) todavia no tiene una ruta para invoicing-service
# — a diferencia de IAM, no hay prefijo "/invoicing" que enrutar. Hasta que exista esa
# ruta, el frontend le habla directo al puerto que vankoo-infra expone en el host
# (docker-compose.yaml: INVOICING_SERVICE_PORT, 8082 por defecto), y el path de
# endpoint es el del controller tal cual ([Route("api/v1/[controller]")]), sin prefijo.
VITE_INVOICING_API_URL="http://localhost:8082"
VITE_INVOICES_ENDPOINT_PATH="/api/v1/invoices"
